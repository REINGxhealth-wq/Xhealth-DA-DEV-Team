 private void LoadHandNoteImage()
        {
            try
            {
                if (isLoadFromFile == true)
                {
                    //Yap - (9399) Load from application path/template folder - 03-10-2018
                    string tmpPath = System.IO.Path.Combine(GlobalVariable.ApplicationPath, @"template");
                    if (System.IO.Directory.Exists(tmpPath))
                    {
                        System.Security.Permissions.FileIOPermission fi;
                        fi = new System.Security.Permissions.FileIOPermission(
                            System.Security.Permissions.FileIOPermissionAccess.PathDiscovery |
                            System.Security.Permissions.FileIOPermissionAccess.Read,
                            tmpPath);
                        fi.AllFiles = System.Security.Permissions.FileIOPermissionAccess.Read;

                        System.IO.DirectoryInfo di = new System.IO.DirectoryInfo(tmpPath);
                        foreach (string ext in SupportedExt)
                        {
                            System.IO.FileInfo[] fis = di.GetFiles(ext);
                            foreach (System.IO.FileInfo finfo in fis)
                            {
                                //Yap - (9399) Add image into usercontrol - 03-10-2018
                                Image tempImage = Image.FromFile(finfo.FullName);
                                HandNoteSection hns = new HandNoteSection(finfo.Name, tempImage, this);
                                hns.Dock = DockStyle.Fill;
                                Panel pnl = new Panel();
                                pnl.Width = 320;
                                pnl.Height = 300;
                                pnl.Controls.Add(hns);
                                pnl.Name = "pnl" + finfo.Name;
                                flowLayoutPanel1.Controls.Add(pnl);                                
                            }
                        }
                    }
                }
                else
                {
                    DataTable dt = ClinicMedicRecord.GetHandnoteTemplate();
                    foreach (DataRow dr in dt.Rows)
                    {
                        byte[] imageInByteArray = new byte[0];
                        imageInByteArray = (dr["file"] != DBNull.Value) ? (byte[])dr["file"] : new byte[0];

                        Image image = ResizeImage(ConvertByteArrayToImage(imageInByteArray)); //Kar Lun - (KL0068) 2020-06-10

                        //Kar Lun - (KL0065) 2020-06-03
                        //HandNoteSection hns = new HandNoteSection(dr["name"].ToString(), image, this);
                        HandNoteSection hns = new HandNoteSection(dr["name"].ToString() + "-" + dr["page"].ToString(), image, this);

                        hns.Dock = DockStyle.Fill;
                        Panel pnl = new Panel();
                        pnl.Width = 320;
                        pnl.Height = 300;
                        pnl.Controls.Add(hns);

                        //Kar Lun - (KL0065) 2020-06-03
                        //pnl.Name = "pnl" + dr["name"].ToString();
                        pnl.Name = "pnl" + dr["name"].ToString() + "-" + dr["page"].ToString();

                        flowLayoutPanel1.Controls.Add(pnl);
                    }
                }
            }
            catch (Exception ex)
            {
                Logger.ErrorException("Failed to load hand note image.", ex);
                Base.ErrorReportForm.Show("Failed to load hand note image", ex, MethodBase.GetCurrentMethod());
            }
        }

