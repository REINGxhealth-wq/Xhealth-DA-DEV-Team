 private void LoadHandNoteImage()
        {
            try
            {
                // Clear old panels
                flowLayoutPanel1.Controls.Clear();

                if (isLoadFromFile)
                {
                    LoadFromFilesSimple();
                }
                else
                {
                    LoadFromDBSimple();
                }
            }
            catch (Exception ex)
            {
                Logger.ErrorException("Failed to load hand note image.", ex);
                Base.ErrorReportForm.Show("Failed to load hand note image", ex, MethodBase.GetCurrentMethod());
            }
        }

        private void LoadFromFilesSimple()
        {
            string templatePath = Path.Combine(GlobalVariable.ApplicationPath, "template");
            if (!Directory.Exists(templatePath)) return;

            // Get all files at once
            var allFiles = new List<FileInfo>();
            foreach (string ext in SupportedExt)
            {
                allFiles.AddRange(new DirectoryInfo(templatePath).GetFiles(ext));
            }

            foreach (var file in allFiles)
            {
                try
                {
                    using (var stream = File.OpenRead(file.FullName))
                    {
                        var image = Image.FromStream(stream);
                        AddHandNotePanel(file.Name, image);
                    }
                }
                catch { } // Skip bad files
            }
        }

        private void LoadFromDBSimple()
        {
            DataTable dt = ClinicMedicRecord.GetHandnoteTemplate();
            if (dt == null) return;

            for (int i = 0; i < dt.Rows.Count; i++)
            {
                var dr = dt.Rows[i];
                try
                {
                    byte[] data = dr["file"] as byte[] ?? new byte[0];
                    if (data.Length == 0) continue;

                    var image = ResizeImage(ConvertByteArrayToImage(data));
                    string name = $"{dr["name"]}-{dr["page"]}";
                    AddHandNotePanel(name, image);
                }
                catch { } // Skip bad rows
            }
        }

        private void AddHandNotePanel(string name, Image image)
        {
            var hns = new HandNoteSection(name, image, this);
            hns.Dock = DockStyle.Fill;

            var pnl = new Panel
            {
                Name = "pnl" + name,
                Width = 320,
                Height = 300,
                Controls = { hns }
            };

            flowLayoutPanel1.Controls.Add(pnl);
        }

