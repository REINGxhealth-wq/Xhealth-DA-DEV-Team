//enhance 

  private void btnsmslist_Click(object sender, EventArgs e)
        {
            // 1. Check internet connection first
            if (!ClinicSms.IsNetConnected())
            {
                MessageBox.Show("Internet is not available. Please check your network connection.",
                               "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation);
                return;
            }

            // 2. Validate data source
            if (cplistDT == null || cplistDT.Rows.Count == 0)
            {
                MessageBox.Show("List is empty, please filter again",
                               "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation);
                return;
            }

            // 3. Get filtered IC list (if filter is active)
            List<string> filteredICList = GetFilteredICList();

            // 4. Create patient list
            List<ClinicPatient> patients = CreatePatientList(cplistDT, filteredICList);

            if (patients.Count == 0)
            {
                MessageBox.Show("No patients match the current filter",
                               "Information", MessageBoxButtons.OK, MessageBoxIcon.Information);
                return;
            }

            // 5. Open SMS form
            using (Sendsmsfrm smsfrm = new Sendsmsfrm(patients, 6))
            {
                smsfrm.ShowDialog(this);
            }
        }

        private List<string> GetFilteredICList()
        {
            if (gridView1.ActiveFilterCriteria == null)
                return null; // No filter, return null to indicate all rows

            try
            {
                // Use DataTable.Select() instead of DataView for better performance
                string filter = DevExpress.Data.Filtering.CriteriaToWhereClauseHelper
                    .GetDataSetWhere(gridView1.ActiveFilterCriteria);

                if (string.IsNullOrEmpty(filter))
                    return null;

                DataTable sourceTable = gcPatient.DataSource as DataTable;
                if (sourceTable == null)
                    return null;

                DataRow[] filteredRows = sourceTable.Select(filter);

                // Use HashSet for O(1) lookups
                var filteredICSet = new HashSet<string>();
                foreach (DataRow dr in filteredRows)
                {
                    string ic = dr["ic"]?.ToString();
                    if (!string.IsNullOrEmpty(ic))
                        filteredICSet.Add(ic);
                }

                return filteredICSet.ToList();
            }
            catch
            {
                return null; // If filter fails, return null to use all data
            }
        }

        private List<ClinicPatient> CreatePatientList(DataTable dataTable, List<string> filteredICList)
        {
            var patients = new List<ClinicPatient>();
            bool useFilter = filteredICList != null && filteredICList.Count > 0;

            // Convert filtered list to HashSet for faster lookups
            var filteredICSet = useFilter ? new HashSet<string>(filteredICList) : null;

            for (int i = 0; i < dataTable.Rows.Count; i++)
            {
                DataRow dr = dataTable.Rows[i];

                // Skip if not in filtered list
                string ic = dr["icpassport"]?.ToString();
                if (useFilter && (string.IsNullOrEmpty(ic) || !filteredICSet.Contains(ic)))
                    continue;

                // Create patient object
                ClinicPatient patient = CreateClinicPatient(dr);
                patients.Add(patient);
            }

            return patients;
        }

        private ClinicPatient CreateClinicPatient(DataRow dr)
        {
            var cp = new ClinicPatient();

            // Parse dates safely
            DateTime tempDate;
            if (DateTime.TryParse(dr["register_date"]?.ToString(), out tempDate))
                cp.RegDate = tempDate;

            if (DateTime.TryParse(dr["DOB"]?.ToString(), out tempDate))
                cp.DOB = tempDate;

            // Set string properties
            cp.ICpassport = dr["icpassport"]?.ToString() ?? "";
            cp.Name = dr["name"]?.ToString() ?? "";
            cp.Sex = dr["sex"]?.ToString() ?? "";
            cp.Street = dr["address"]?.ToString() ?? "";
            cp.City = dr["city"]?.ToString() ?? "";
            cp.State = dr["state"]?.ToString() ?? "";
            cp.Country = dr["country"]?.ToString() ?? "";
            cp.Postcode = dr["postcode"]?.ToString() ?? "";
            cp.Home = dr["phone_fixed"]?.ToString() ?? "";
            cp.Mobile = dr["phone_mobile"]?.ToString() ?? "";
            cp.Remark = dr["remark"]?.ToString() ?? "";
            cp.Medicalillness = dr["medical_illness"]?.ToString() ?? "";
            cp.Occupation = dr["occupation"]?.ToString() ?? "";
            cp.Race = dr["race"]?.ToString() ?? "";
            cp.Billingtype = dr["BillingStatus"]?.ToString() ?? "";

            // Set boolean properties
            cp.Upcoming_Appointment = dr["upcoming_apt"]?.ToString() == "true";
            cp.Incomplete_Treatment = dr["incomplete_tp"]?.ToString() == "true";

            // Set outstanding balance
            string outstandingBal = dr["outstanding_bal"]?.ToString();
            cp.Outstanding_Balance = string.IsNullOrEmpty(outstandingBal) ? "0" : outstandingBal;

            // Heavy loading operations commented out as per original
            // cp.AllergyId = ClinicPatient.LoadAllergies(cp.ICpassport);
            // cp.RelationList = ClinicPatient.LoadRelation(cp.ICpassport);
            // cp.Photo = ClinicPatient.LoadPhoto(cp.ICpassport);

            return cp;
        }
