//Enhanced
    public void LoadTemplatesFromDB()
        {
            cbselectimg.Items.Clear();

            // Initialize
            templateDict = templateDict ?? new Dictionary<string, Image>();
            templateDict.Clear();

            DataTable dt = ClinicMedicRecord.GetHandnoteTemplate();
            if (dt == null) return;

            List<string> tmpPaths = new List<string>();

            // OPTIMIZATION: Cache page counts to avoid repeated DB calls
            var pageCountCache = new Dictionary<string, int>();

            foreach (DataRow dr in dt.Rows)
            {
                string templateName = dr["name"]?.ToString();
                if (string.IsNullOrEmpty(templateName))
                    continue;

                string displayName = templateName;

                // Get page count with caching
                if (!pageCountCache.ContainsKey(templateName))
                {
                    pageCountCache[templateName] = ClinicMedicRecord.GetTemplatePageCount(templateName);
                }

                int pageCount = pageCountCache[templateName];

                if (pageCount > 1)
                {
                    string pageNum = dr["page"]?.ToString() ?? "0";
                    displayName = templateName + " Page " + pageNum;
                }

                tmpPaths.Add(displayName);

                if (!templateDict.ContainsKey(displayName))
                {
                    if (dr["file"] != DBNull.Value && dr["file"] != null)
                    {
                        byte[] imageInByteArray = (byte[])dr["file"];
                        if (imageInByteArray != null && imageInByteArray.Length > 0)
                        {
                            Image image = ConvertByteArrayToImage(imageInByteArray);
                            if (image != null)
                            {
                                templateDict.Add(displayName, image);
                            }
                        }
                    }
                }
            }

            // Rest of your code remains the same
            cbselectimg.Items.Add("All");
            cbselectimg.Items.AddRange(tmpPaths.ToArray());

            if (cbselectimg.Items.Count > 0)
            {
                cbselectimg.SelectedIndex = 0;

                if (cbselectimg.Text == "All")
                {
                    LoadCSDetails2();
                }
                else
                {
                    LoadCSDetails3(cbselectimg.Text);
                }

                panel1.VerticalScroll.Value = 0;
            }
        }
