        public void BindNotationlegend()
        {
            DataTable DT = DentalChartNotation.GetNotationMasterList(ddltoothtype.Text, txtnotationtitle.Text);
            DT.Columns.Add("toothtype2");

            foreach (DataRow row in DT.Rows)
            {
                string toothType = row["toothtype"].ToString();
                row["toothtype2"] = toothType == "A" ? "Premolar / Molar" :
                                   toothType == "B" ? "Incisor" : "";
            }

            GRVNotationMaster.DataSource = DT;
        }
