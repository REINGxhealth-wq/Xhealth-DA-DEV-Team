    private void btnsms_Click(object sender, EventArgs e)
        {
            if (ClinicSms.IsNetConnected())
            {
                List<ClinicAppointment> lsAppointment;
                lsAppointment = ls;

                //Jing Yi (DAS-1606) Check if any filtering is applied by user - 2023-04-21
                if (gcMain_grid.ActiveFilterCriteria != null)
                {
                    var filteredDataView = new DataView(gcMain.DataSource as DataTable);
                    filteredDataView.RowFilter = DevExpress.Data.Filtering.CriteriaToWhereClauseHelper.GetDataSetWhere(gcMain_grid.ActiveFilterCriteria);
                    DataTable dt = filteredDataView.ToTable();
                    List<long> filtered_id = new List<long>(); //To store the list of appt id that is filtered
                    foreach (DataRow dr in dt.Rows)
                    {
                        filtered_id.Add(Convert.ToInt64(dr["id"]));
                    }
                    lsAppointment = lsAppointment.Where(i => filtered_id.Contains(i.ID)).ToList(); //Only keep the appts that is filtered 
                }

                if (lsAppointment.Count > 0)
                {
                    using (Sendsmsfrm smsfrm = new Sendsmsfrm(lsAppointment, 4))
                    {
                        smsfrm.ShowDialog(this); //Yap - (DAS-29) Change to showdialog - 12-09-2020
                    }
                }
                else
                {
                    MessageBox.Show("SMS cannot be send because list is empty.", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation);
                    return;
                }
            }
            else
            {
                MessageBox.Show("Internet is not available. Please check your network connection.", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation);
                return;
            }
        }







