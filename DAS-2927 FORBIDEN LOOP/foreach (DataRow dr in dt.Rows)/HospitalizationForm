 private void btnsms_Click(object sender, EventArgs e)
        {
            if (ClinicSms.IsNetConnected())
            {
                List<ClinicHospitalization> lstp = lsHospitalize;

                //Jing Yi (DAS-1606) Check if any filtering is applied by user - 2023-04-21
                if (gvHospitalizedList.ActiveFilterCriteria != null)
                {
                    var filteredDataView = new DataView(gcHospitalizedList.DataSource as DataTable);
                    filteredDataView.RowFilter = DevExpress.Data.Filtering.CriteriaToWhereClauseHelper.GetDataSetWhere(gvHospitalizedList.ActiveFilterCriteria);
                    DataTable dt = filteredDataView.ToTable();
                    List<string> filtered_id = new List<string>(); //To store the list of appt id that is filtered
                    foreach (DataRow dr in dt.Rows)
                    {
                        filtered_id.Add(dr["id"].ToString());
                    }
                    lstp = lstp.Where(i => filtered_id.Contains(i.ID)).ToList(); //Only keep the appts that is filtered 
                }

                if (lstp.Count > 0)
                {
                    using (Sendsmsfrm smsfrm = new Sendsmsfrm(lstp, 7))
                    {
                        smsfrm.ShowDialog(this);
                    }
                }
                else
                {
                    MessageBox.Show("List is empty,please filter again", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation);
                    return;
                }
            }
            else
            {
                MessageBox.Show("No internet connected to your Computer/Laptop", "Warning", MessageBoxButtons.OK, MessageBoxIcon.Exclamation);
                return;
            }
        }

