        public static MedicItem GetItemByName(string itemName, bool isMedic = false)
        {
            // Build SQL components first
            string _locationFilter = GlobalVariable.StoreEnable == "1"
                ? $"AND `a`.`store_id`='{GlobalVariable.DefaultStoreID}'"
                : $"AND `a`.`location_id`='{GlobalVariable.DefaultLocationID}'";

            string medicFilter = isMedic ? " AND `b`.`is_print`=1 " : "";

            // Single string interpolation for entire query
            string sql = $@"
        SELECT 
            b.commission, b.unit_cost, `b`.`id` AS `item_id`, `name`, `company`, `category`, `selling_price`,
            SUM(`a`.`buy_qty`) AS `buytotal`, SUM(`a`.`total`) AS `currenttotal`, 
            `is_service`, `dose`, `times`, `day`, `b`.`procedure`, `is_print`, `proposed_qty`, `proposed_remark`,
            `doseqty`, `timesqty`, `stockcode`, `alternatecode`, `restock_level`, `ratio`, `tax_code`, is_restrict,
            classification, manufacturer, brand, uom, TYPE, 
            IFNULL((SELECT id FROM medication_type WHERE type_name = b.TYPE LIMIT 1), 0) AS 'type_id', 
            b.is_vaccine, b.repeat_interval, b.repeat_interval_format    
        FROM (`stock_items` `b` 
        LEFT JOIN `stock_ledger` `a` ON (`b`.`id` = `a`.`item_id` {_locationFilter})) 
        WHERE `b`.`name` = ?ctg AND `b`.`removed` = 0 {medicFilter}
        GROUP BY `b`.`id` 
        ORDER BY `category`, `name`
        LIMIT 1";  // Added LIMIT 1 since we only expect one result

            using (MySqlConnection conn = new MySqlConnection(ECModel.Instance.ConnString))
            using (MySqlCommand cmd = new MySqlCommand(sql, conn))
            {
                cmd.Parameters.Add("?ctg", MySqlDbType.String).Value = itemName;

                try
                {
                    conn.Open();
                    using (MySqlDataReader reader = cmd.ExecuteReader())
                    {
                        return reader.Read() ? CreateMedicItemFromReaderOptimized(reader) : null;
                    }
                }
                catch (MySqlException ex)
                {
                    Logger.ErrorException("Failed to populate items: ", ex);
                    return null;
                }
            }
        }

