            };

            // Create MedicItem with direct ternary operations (fastest)
            var mi = new MedicItem(
                reader.GetString(ord.ItemId),
                reader.GetString(ord.Name),
                reader.IsDBNull(ord.AlternateCode) ? "" : reader.GetString(ord.AlternateCode),
                reader.IsDBNull(ord.Category) ? "" : reader.GetString(ord.Category),
                reader.IsDBNull(ord.Company) ? "" : reader.GetString(ord.Company),
                reader.IsDBNull(ord.SellingPrice) ? -1d : reader.GetDouble(ord.SellingPrice),
                reader.IsDBNull(ord.IsService) ? 0 : reader.GetInt32(ord.IsService),
                reader.IsDBNull(ord.Dose) ? 0 : reader.GetInt32(ord.Dose),
                reader.IsDBNull(ord.Times) ? 0 : reader.GetInt32(ord.Times),
